[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[alias]
	st = status -sb
	co = checkout
	lg = log --oneline --graph --decorate -20
